# Managed by NDI deployment
# 使用不含查询字符串的日志格式，避免记录对象预签名凭据。
log_format ndi_safe '$remote_addr - $host [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen @@WEB_PORT@@;
    server_name @@PUBLIC_IP@@;
    include /etc/nginx/mime.types;
    root /opt/ndi/frontend-current;
    index index.html;
    client_max_body_size 25m;
    access_log /var/log/nginx/ndi-access.log ndi_safe;
    error_log /var/log/nginx/ndi-error.log warn;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:@@APP_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Forwarded "";
        proxy_read_timeout 120s;
        proxy_intercept_errors off;
        add_header Cache-Control "no-store" always;
    }
    location = /api { return 404; }
    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }
    location ~ /\. { deny all; }
    location ^~ /assets/ {
        root /opt/ndi/shared;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}

server {
    listen @@FILES_PORT@@;
    server_name @@PUBLIC_IP@@;
    client_max_body_size 25m;
    access_log /var/log/nginx/ndi-files-access.log ndi_safe;
    error_log /var/log/nginx/ndi-files-error.log warn;

    location / {
        proxy_pass http://@@MINIO_UPSTREAM@@;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Forwarded "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_intercept_errors off;
    }
}
