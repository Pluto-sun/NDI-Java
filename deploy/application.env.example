# systemd 环境文件，不加 export；密码在服务器本地编辑，禁止提交或粘贴到日志。
# 支持普通字符串或双引号包围的完整值，不使用 ${变量} 引用。
SPRING_PROFILES_ACTIVE=prod
NDI_AUTH_MODE=SESSION
NDI_SECURE_COOKIE=true
NDI_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/ndi?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC"
NDI_DATASOURCE_USERNAME=CHANGE_ME
NDI_DATASOURCE_PASSWORD=CHANGE_ME
NDI_MINIO_ENDPOINT=http://127.0.0.1:9000
NDI_MINIO_PUBLIC_ENDPOINT=https://CHANGE_ME
NDI_MINIO_ACCESS_KEY=CHANGE_ME
NDI_MINIO_SECRET_KEY=CHANGE_ME
NDI_MINIO_BUCKET=CHANGE_ME
# 空数据库首次启动需配置管理员；已有可登录管理员时不覆盖其密码。
NDI_BOOTSTRAP_ADMIN_LOGIN=
NDI_BOOTSTRAP_ADMIN_PASSWORD=
NDI_BACKUP_DIRECTORY=/var/lib/ndi/backups
# 根据服务器内存自行配置，不在此处填写任何密码。
# JAVA_TOOL_OPTIONS="-Xms256m -Xmx1024m"
